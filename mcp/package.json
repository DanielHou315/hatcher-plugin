{
  "name": "hatcher-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local (stdio) MCP server for Hatcher: publish and update private, shareable HTML pages through its REST API.",
  "license": "MIT",
  "type": "module",
  "bin": { "hatcher-mcp": "dist/hatcher-mcp.mjs" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/hatcher-mcp.mjs --banner:js=\"#!/usr/bin/env node\" --legal-comments=none --minify",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
